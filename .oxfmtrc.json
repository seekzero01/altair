{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.pnpm-store/**",
    "**/next-env.d.ts",
    "pnpm-lock.yaml",
    "**/AGENTS.md"
  ]
}
