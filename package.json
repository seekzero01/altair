{
  "name": "altair",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint --disable-nested-config --max-warnings 0 .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:fix": "oxlint --disable-nested-config --fix --max-warnings 0 .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test:integration": "turbo run test:integration",
    "audit": "pnpm audit",
    "verify": "turbo run lint format typecheck test test:integration build"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "@types/node": "^24.0.0",
    "oxlint": "1.93.0",
    "oxfmt": "0.78.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0"
    }
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  }
}
